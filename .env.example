# Variáveis usadas pelo docker-compose para subir MySQL + backend + frontend.
# Copie este arquivo para .env e ajuste se necessário:
#   cp .env.example .env

# ---- MySQL ----
MYSQL_USER=financeiro
MYSQL_PASSWORD=<LOCAL_MYSQL_PASSWORD>
MYSQL_DATABASE=financeiro_db
MYSQL_ROOT_PASSWORD=<LOCAL_MYSQL_ROOT_PASSWORD>
MYSQL_PORT=3306

# ---- Backend ----
# URL que o backend usa para conectar no MySQL (host = nome do serviço Docker).
DATABASE_URL=mysql+pymysql://financeiro:<LOCAL_MYSQL_PASSWORD>@mysql:3306/financeiro_db

# Em produção, gere uma chave forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ---- Rede local ----
# Frontend disponível na rede; API/MySQL publicados somente em 127.0.0.1.
FRONTEND_BIND=0.0.0.0
# ---- Portas expostas no host ----
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Vercel: não copie os valores Docker acima. Cadastre as variáveis no painel.
# DATABASE_URL=mysql+pymysql://<USER>:<PASSWORD>@<HOST>:3306/<DATABASE>
# DATABASE_SSL=true
# DATABASE_SSL_CA= (PEM fornecido pelo provedor, se a CA não for pública)
# CORS_ORIGINS= (vazio para frontend e API no mesmo domínio)
# REDIS_URL=rediss://<USER>:<PASSWORD>@<HOST>:<PORT>/0
# Veja docs/vercel-deployment.md para ambientes e migrations.
